{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.2",
  "small_model": "opencode-go/mimo-v2.5",
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "dd *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "halt *": "deny",
      "poweroff *": "deny",
      "git clean *": "ask",
      "git reset --hard*": "ask",
      "git reset * --hard*": "ask",
      "git push -f*": "ask",
      "git push * -f*": "ask",
      "git push --force*": "ask",
      "git push * --force*": "ask"
    }
  },
  "agent": {
    "build": {
      "model": "opencode-go/glm-5.2"
    },
    "plan": {
      "model": "opencode-go/glm-5.2",
      "permission": {
        "bash": {
          "*": "ask",
          "pwd *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "tree *": "allow",
          "du *": "allow",
          "df *": "allow",
          "find *": "allow",
          "fd *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "diff *": "allow",
          "jq *": "allow",
          "which *": "allow",
          "command -v *": "allow",
          "printenv *": "allow",
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git branch *": "allow",
          "git stash list": "allow",
          "sudo *": "deny",
          "dd *": "deny",
          "shutdown *": "deny",
          "reboot *": "deny",
          "halt *": "deny",
          "poweroff *": "deny"
        }
      }
    },
    "orchestrator": {
      "description": "Primary agent for complex multi-step work. Decomposes tasks, delegates to specialized subagents, and integrates results. Does not write application code directly.",
      "mode": "primary",
      "model": "opencode-go/qwen3.7-max",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "allow"
      }
    },
    "general": {
      "model": "opencode-go/glm-5.2"
    },
    "explore": {
      "model": "opencode-go/mimo-v2.5"
    },
    "scout": {
      "description": "Read-only agent for external docs and dependency research. Use this when you need current library/framework/API documentation, version-specific behavior, or to cross-reference local dependency usage against upstream source.",
      "mode": "subagent",
      "model": "opencode-go/qwen3.8-flash",
      "prompt": "{file:./prompts/scout.txt}",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "reviewer": {
      "description": "Read-only code reviewer. Use for quality, security, and maintainability feedback before merging changes.",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "coder": {
      "description": "Implements a single, bounded coding task from a clear spec. Use when a task has already been decomposed.",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code"
    },
    "runner": {
      "description": "Executes bounded shell command sequences: running tests, git operations (status/diff/add/commit/log), installs, builds, linters. Reports output verbatim. Does not write or edit application code.",
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "tester": {
      "description": "Writes and runs tests, reports failures verbatim. Does not refactor production code.",
      "mode": "subagent",
      "model": "opencode-go/qwen3.8-flash"
    },
    "documenter": {
      "description": "Writes and updates Markdown documentation. Can create and edit Markdown files freely; changes to any other file type require confirmation.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "permission": {
        "edit": {
          "*": "ask",
          "*.md": "allow"
        }
      }
    },
    "architect": {
      "description": "Designs architecture, APIs, and migration plans. Read-only; produces specs and ADRs.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "compaction": {
      "model": "opencode-go/mimo-v2.5"
    },
    "title": {
      "model": "opencode-go/mimo-v2.5"
    },
    "summary": {
      "model": "opencode-go/mimo-v2.5"
    }
  }
}
