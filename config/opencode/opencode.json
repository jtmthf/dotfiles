{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "dd *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shutdown *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "reboot *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "halt *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "poweroff *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset * --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push -f*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push * -f*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push * --force*",
      "effect": "ask"
    }
  ],
  "agents": {
    "build": {
      "description": "Default hands-on coding agent for direct work outside the orchestrator flow.",
      "mode": "all",
      "model": "opencode-go/deepseek-v4.1-flash#max",
      "system": "{file:./prompts/build.txt}"
    },
    "plan": {
      "mode": "all",
      "model": "opencode-go/glm-5.3-flash#high",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "pwd *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "stat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "file *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tree *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "du *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "df *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "fd *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sort *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "uniq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "jq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "which *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "command -v *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "printenv *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git stash list",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sudo *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "dd *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "shutdown *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "reboot *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "halt *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "poweroff *",
          "effect": "deny"
        }
      ]
    },
    "orchestrator": {
      "description": "Primary agent for complex multi-step work. Decomposes tasks, delegates to specialized subagents, and integrates results. Does not write application code directly.",
      "mode": "primary",
      "model": "opencode-go/glm-5.3-flash#low",
      "system": "{file:./prompts/orchestrator.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "mode": "all",
      "model": "opencode-go/glm-5.3-flash#high"
    },
    "explore": {
      "mode": "all",
      "model": "opencode-go/mimo-v2.5"
    },
    "scout": {
      "description": "Read-only agent for external docs and dependency research. Use this when you need current library/framework/API documentation, version-specific behavior, or to cross-reference local dependency usage against upstream source.",
      "mode": "subagent",
      "model": "opencode-go/qwen3.8-flash#medium",
      "system": "{file:./prompts/scout.txt}",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "ask"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "reviewer": {
      "description": "Read-only code reviewer. Use for quality, security, and maintainability feedback before merging changes.",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "system": "{file:./prompts/reviewer.txt}",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "pwd *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "stat *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "file *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tree *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "du *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "df *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "fd *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sort *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "uniq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "jq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "which *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "command -v *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "printenv *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git merge-base *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git stash list",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sudo *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "dd *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "shutdown *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "reboot *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "halt *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "poweroff *",
          "effect": "deny"
        }
      ]
    },
    "coder": {
      "description": "Implements a single, bounded coding task from a clear spec. Use when a task has already been decomposed.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash#max",
      "system": "{file:./prompts/coder.txt}"
    },
    "runner": {
      "description": "Executes bounded shell command sequences: running tests, git operations (status/diff/add/commit/log), installs, builds, linters. Reports output verbatim. Does not write or edit application code.",
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5",
      "system": "{file:./prompts/runner.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "tester": {
      "description": "Writes and runs tests, reports failures verbatim. Does not refactor production code.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash#high",
      "system": "{file:./prompts/tester.txt}"
    },
    "documenter": {
      "description": "Writes and updates Markdown documentation. Can create and edit Markdown files freely; changes to any other file type require confirmation.",
      "mode": "subagent",
      "model": "opencode-go/gpt-6-luna",
      "system": "{file:./prompts/documenter.txt}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "edit",
          "resource": "*.md",
          "effect": "allow"
        }
      ]
    },
    "architect": {
      "description": "Designs architecture, APIs, and migration plans. Read-only; produces specs and ADRs.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.3#max",
      "system": "{file:./prompts/architect.txt}",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "compaction": {
      "mode": "all",
      "model": "opencode-go/mimo-v2.5"
    },
    "title": {
      "mode": "all",
      "model": "opencode-go/mimo-v2.5"
    },
    "summary": {
      "mode": "all",
      "model": "opencode-go/mimo-v2.5"
    }
  }
}
